{
  "version": 3,
  "group": "mod",
  "properties": [
    {
      "name": "BUILD_COORDS",
      "type": "build_system_coordinates",
      "order": 10
    },
    {
      "name": "MOD_ID",
      "type": "string",
      "validator": "[a-z][a-z0-9-_]{1,63}",
      "derives": {
        "parents": [
          "PROJECT_NAME"
        ],
        "method": "replace",
        "parameters": {
          "regex": "[^a-z0-9-_]+",
          "replacement": "_",
          "maxLength": 64,
          "lowercase": true
        }
      }
    },
    {
      "name": "MOD_NAME",
      "type": "string",
      "inheritFrom": "PROJECT_NAME"
    },
    {
      "name": "MAIN_CLASS",
      "type": "class_fqn",
      "derives": {
        "parents": [
          "BUILD_COORDS",
          "MOD_ID"
        ],
        "method": "suggestClassName"
      }
    },
    {
      "name": "LANGUAGE",
      "label": "creator.ui.language.label",
      "type": "string",
      "default": "java",
      "options": [
        "java",
        "kotlin"
      ]
    },
    {
      "name": "MINECRAFT_VERSION",
      "label": "creator.ui.minecraft_version.label",
      "type": "string",
      "default": "26.1.2"
    },
    {
      "name": "BSTATS_PLUGIN_ID",
      "label": "creator.ui.bstats_plugin_id.label",
      "type": "integer",
      "default": 0
    },
    {
      "name": "LICENSE",
      "type": "license"
    },
    {
      "label": "creator.ui.optional_settings.label",
      "collapsible": true,
      "groupProperties": [
        {
          "name": "DESCRIPTION",
          "type": "string",
          "default": ""
        },
        {
          "name": "AUTHORS",
          "type": "inline_string_list",
          "default": ""
        },
        {
          "name": "WEBSITE",
          "type": "string",
          "default": ""
        }
      ]
    },
    {
      "name": "JAVA_VERSION",
      "type": "integer",
      "order": 20,
      "default": 21,
      "visible": false
    },
    {
      "name": "JDK",
      "type": "jdk",
      "order": 20,
      "default": "JAVA_VERSION"
    }
  ],
  "files": [
    {
      "template": "../Gradle.gitignore.ft",
      "destination": ".gitignore",
      "condition": "$USE_GIT"
    },
    {
      "template": "../licenses/${LICENSE.id}.txt.ft",
      "destination": "LICENSE.txt"
    },
    {
      "template": "build.gradle.ft",
      "destination": "build.gradle"
    },
    {
      "template": "settings.gradle.ft",
      "destination": "settings.gradle"
    },
    {
      "template": "gradle.properties.ft",
      "destination": "gradle.properties"
    },
    {
      "template": "README.md.ft",
      "destination": "README.md"
    },
    {
      "template": "ci.yml.ft",
      "destination": ".github/workflows/ci.yml",
      "condition": "$USE_GIT"
    },
    {
      "template": "common/build.gradle.ft",
      "destination": "common/build.gradle"
    },
    {
      "template": "common/messages.properties.ft",
      "destination": "common/src/main/resources/messages.properties"
    },
    {
      "template": "common/Constants.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/Constants.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "common/Constants.kt.ft",
      "destination": "common/src/main/kotlin/${MAIN_CLASS.packagePath}/Constants.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "common/CommonClass.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/CommonClass.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "common/CommonClass.kt.ft",
      "destination": "common/src/main/kotlin/${MAIN_CLASS.packagePath}/CommonClass.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "common/platform/Services.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/platform/Services.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "common/platform/Services.kt.ft",
      "destination": "common/src/main/kotlin/${MAIN_CLASS.packagePath}/platform/Services.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "common/platform/services/IPlatformHelper.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/platform/services/IPlatformHelper.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "common/platform/services/IPlatformHelper.kt.ft",
      "destination": "common/src/main/kotlin/${MAIN_CLASS.packagePath}/platform/services/IPlatformHelper.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "common/CommonClassTest.java.ft",
      "destination": "common/src/test/java/${MAIN_CLASS.packagePath}/CommonClassTest.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "common/CommonClassTest.kt.ft",
      "destination": "common/src/test/kotlin/${MAIN_CLASS.packagePath}/CommonClassTest.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "common/bootstrap/Bootstrap.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/bootstrap/Bootstrap.java"
    },
    {
      "template": "common/bootstrap/BootstrapContext.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/bootstrap/BootstrapContext.java"
    },
    {
      "template": "common/compat/CompatibilityGuardrails.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/compat/CompatibilityGuardrails.java"
    },
    {
      "template": "common/config/PluginConfig.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/config/PluginConfig.java"
    },
    {
      "template": "common/config/PluginConfigLoader.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/config/PluginConfigLoader.java"
    },
    {
      "template": "common/command/SimpleCommand.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/command/SimpleCommand.java"
    },
    {
      "template": "common/command/CommandRegistry.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/command/CommandRegistry.java"
    },
    {
      "template": "common/security/Permissions.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/security/Permissions.java"
    },
    {
      "template": "common/text/MessageKeys.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/text/MessageKeys.java"
    },
    {
      "template": "common/text/MiniMessageSupport.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/text/MiniMessageSupport.java"
    },
    {
      "template": "common/text/Localization.java.ft",
      "destination": "common/src/main/java/${MAIN_CLASS.packagePath}/text/Localization.java"
    },
    {
      "template": "paper/build.gradle.ft",
      "destination": "paper/build.gradle"
    },
    {
      "template": "paper/PaperPlugin.java.ft",
      "destination": "paper/src/main/java/${MAIN_CLASS.packagePath}/paper/PaperPlugin.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "paper/PaperPlugin.kt.ft",
      "destination": "paper/src/main/kotlin/${MAIN_CLASS.packagePath}/paper/PaperPlugin.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "paper/PaperPlatformHelper.java.ft",
      "destination": "paper/src/main/java/${MAIN_CLASS.packagePath}/paper/PaperPlatformHelper.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "paper/PaperPlatformHelper.kt.ft",
      "destination": "paper/src/main/kotlin/${MAIN_CLASS.packagePath}/paper/PaperPlatformHelper.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "paper/plugin.yml.ft",
      "destination": "paper/src/main/resources/plugin.yml"
    },
    {
      "template": "paper/PaperMetricsBootstrap.java.ft",
      "destination": "paper/src/main/java/${MAIN_CLASS.packagePath}/paper/PaperMetricsBootstrap.java"
    },
    {
      "template": "paper/PaperCommandBridge.java.ft",
      "destination": "paper/src/main/java/${MAIN_CLASS.packagePath}/paper/PaperCommandBridge.java"
    },
    {
      "template": "paper/IPlatformHelper.ft",
      "destination": "paper/src/main/resources/META-INF/services/${MAIN_CLASS.packageName}.platform.services.IPlatformHelper"
    },
    {
      "template": "velocity/build.gradle.ft",
      "destination": "velocity/build.gradle"
    },
    {
      "template": "velocity/VelocityPlugin.java.ft",
      "destination": "velocity/src/main/java/${MAIN_CLASS.packagePath}/velocity/VelocityPlugin.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "velocity/VelocityPlugin.kt.ft",
      "destination": "velocity/src/main/kotlin/${MAIN_CLASS.packagePath}/velocity/VelocityPlugin.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "velocity/VelocityPlatformHelper.java.ft",
      "destination": "velocity/src/main/java/${MAIN_CLASS.packagePath}/velocity/VelocityPlatformHelper.java",
      "condition": "${LANGUAGE} != 'kotlin'"
    },
    {
      "template": "velocity/VelocityPlatformHelper.kt.ft",
      "destination": "velocity/src/main/kotlin/${MAIN_CLASS.packagePath}/velocity/VelocityPlatformHelper.kt",
      "condition": "${LANGUAGE} == 'kotlin'"
    },
    {
      "template": "velocity/velocity-plugin.json.ft",
      "destination": "velocity/src/main/resources/velocity-plugin.json"
    },
    {
      "template": "velocity/VelocityMetricsBootstrap.java.ft",
      "destination": "velocity/src/main/java/${MAIN_CLASS.packagePath}/velocity/VelocityMetricsBootstrap.java"
    },
    {
      "template": "velocity/VelocityCommandBridge.java.ft",
      "destination": "velocity/src/main/java/${MAIN_CLASS.packagePath}/velocity/VelocityCommandBridge.java"
    },
    {
      "template": "velocity/IPlatformHelper.ft",
      "destination": "velocity/src/main/resources/META-INF/services/${MAIN_CLASS.packageName}.platform.services.IPlatformHelper"
    }
  ]
}
