package ${MAIN_CLASS.packageName}.platform.services;

import com.mojang.serialization.MapCodec;
import net.minecraft.core.Holder;
import net.minecraft.core.component.DataComponentType;
import net.minecraft.core.particles.ParticleType;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.world.effect.MobEffect;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.ai.attributes.Attribute;
import net.minecraft.world.entity.npc.VillagerProfession;
import net.minecraft.world.inventory.MenuType;
import net.minecraft.world.item.ArmorMaterial;
import net.minecraft.world.item.CreativeModeTab;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.alchemy.Potion;
import net.minecraft.world.item.crafting.RecipeSerializer;
import net.minecraft.world.item.crafting.RecipeType;
import net.minecraft.world.item.enchantment.Enchantment;
import net.minecraft.world.item.enchantment.effects.EnchantmentEntityEffect;
import net.minecraft.world.item.enchantment.effects.EnchantmentLocationBasedEffect;
import net.minecraft.world.item.enchantment.effects.EnchantmentValueEffect;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.entity.BlockEntityType;
import net.minecraft.world.level.material.Fluid;

import java.util.function.Supplier;
import java.util.function.UnaryOperator;

import ${MAIN_CLASS.packageName}.registry.RegistryEntry;

/**
 * Service interface for registering and retrieving game content across platforms.
 * <p>
 * This interface abstracts the platform-specific registration logic (e.g., Fabric vs. Forge/NeoForge),
 * allowing common code to register blocks, items, entities, etc., in a unified way.
 */
public interface IContentRegistry {

    /**
     * Registers a block and stores its holder.
     *
     * @param id    The resource location identifier for the block.
     * @param block A supplier providing the block instance.
     * @param <T>   The type of the block.
     */
    <T extends Block> RegistryEntry<T> registerBlock(ResourceLocation id, Supplier<T> block);

    /**
     * Registers an item and stores its holder.
     *
     * @param id   The resource location identifier for the item.
     * @param item A supplier providing the item instance.
     * @param <T>  The type of the item.
     */
    <T extends Item> RegistryEntry<T> registerItem(ResourceLocation id, Supplier<T> item);

    /**
     * Registers a mob effect and stores its holder.
     *
     * @param id     The resource location identifier for the effect.
     * @param effect A supplier providing the mob effect instance.
     * @param <T>    The type of the mob effect.
     */
    <T extends MobEffect> RegistryEntry<T> registerEffect(ResourceLocation id, Supplier<T> effect);

    /**
     * Registers an entity type and stores its holder.
     *
     * @param id     The resource location identifier for the entity type.
     * @param entity A supplier providing the entity type instance.
     * @param <T>    The type of the entity.
     */
    <T extends Entity> RegistryEntry<EntityType<T>> registerEntity(ResourceLocation id, Supplier<EntityType<T>> entity);

    /**
     * Registers a creative mode tab and stores its holder.
     *
     * @param id  The resource location identifier for the creative tab.
     * @param tab A supplier providing the creative mode tab instance.
     * @param <T> The type of the creative mode tab.
     */
    <T extends CreativeModeTab> RegistryEntry<T> registerCreativeTab(ResourceLocation id, Supplier<T> tab);

    /**
     * Registers an armor material and stores its holder.
     *
     * @param id            The resource location identifier for the armor material.
     * @param armorMaterial A supplier providing the armor material instance.
     * @param <T>           The type of the armor material.
     */
    <T extends ArmorMaterial> RegistryEntry<T> registerArmorMaterial(ResourceLocation id, Supplier<T> armorMaterial);


    /**
     * Registers a fluid and stores its holder.
     *
     * @param id    The resource location identifier for the fluid.
     * @param fluid A supplier providing the fluid instance.
     * @param <T>   The type of the fluid.
     */
    <T extends Fluid> RegistryEntry<T> registerFluid(ResourceLocation id, Supplier<T> fluid);

    /**
     * Registers a potion and stores its holder.
     *
     * @param id     The resource location identifier for the potion.
     * @param potion A supplier providing the potion instance.
     * @param <T>    The type of the potion.
     */
    <T extends Potion> RegistryEntry<T> registerPotion(ResourceLocation id, Supplier<T> potion);

    /**
     * Registers a sound event and stores its holder.
     *
     * @param id    The resource location identifier for the sound event.
     * @param sound A supplier providing the sound event instance.
     * @param <T>   The type of the sound event.
     */
    <T extends SoundEvent> RegistryEntry<T> registerSound(ResourceLocation id, Supplier<T> sound);

    /**
     * Registers a block entity type and stores its holder.
     *
     * @param id    The resource location identifier for the block entity type.
     * @param block A supplier providing the block entity type instance.
     * @param <T>   The type of the block entity.
     */
    <T extends BlockEntityType<?>> RegistryEntry<T> registerBlockEntity(ResourceLocation id, Supplier<T> block);

    /**
     * Registers a data component type and stores its holder.
     *
     * @param id      The resource location identifier for the data component type.
     * @param builder A function to configure the data component type builder.
     * @param <T>     The type of the data component.
     */
    <T> RegistryEntry<DataComponentType<T>> registerDataComponent(ResourceLocation id, UnaryOperator<DataComponentType.Builder<T>> builder);

    /**
     * Registers an attribute and stores its holder.
     *
     * @param id        The resource location identifier for the attribute.
     * @param attribute A supplier providing the attribute instance.
     * @param <T>       The type of the attribute.
     */
    <T extends Attribute> RegistryEntry<T> registerAttribute(ResourceLocation id, Supplier<T> attribute);

    /**
     * Registers a particle type and stores its holder.
     *
     * @param id       The resource location identifier for the particle type.
     * @param particle A supplier providing the particle type instance.
     * @param <T>      The type of the particle.
     */
    <T extends ParticleType<?>> RegistryEntry<T> registerParticle(ResourceLocation id, Supplier<T> particle);

    /**
     * Registers a menu type and stores its holder.
     *
     * @param id   The resource location identifier for the menu type.
     * @param menu A supplier providing the menu type instance.
     * @param <T>  The type of the menu.
     */
    <T extends MenuType<?>> RegistryEntry<T> registerMenu(ResourceLocation id, Supplier<T> menu);

    /**
     * Registers a recipe serializer and stores its holder.
     *
     * @param id         The resource location identifier for the recipe serializer.
     * @param serializer A supplier providing the recipe serializer instance.
     * @param <T>        The type of the recipe serializer.
     */
    <T extends RecipeSerializer<?>> RegistryEntry<T> registerRecipeSerializer(ResourceLocation id, Supplier<T> serializer);

    /**
     * Registers a recipe type and stores its holder.
     *
     * @param id   The resource location identifier for the recipe type.
     * @param type A supplier providing the recipe type instance.
     * @param <T>  The type of the recipe.
     */
    <T extends RecipeType<?>> RegistryEntry<T> registerRecipeType(ResourceLocation id, Supplier<T> type);

    /**
     * Registers a villager profession and stores its holder.
     *
     * @param id         The resource location identifier for the villager profession.
     * @param profession A supplier providing the villager profession instance.
     * @param <T>        The type of the villager profession.
     */
    <T extends VillagerProfession> RegistryEntry<T> registerVillagerProfession(ResourceLocation id, Supplier<T> profession);

    /**
     * Registers an Enchantment Entity Effect codec.
     *
     * @param id    The identifier for the effect.
     * @param codec The codec for the effect.
     * @param <T>   The type of the effect.
     * @return The registered codec.
     */
    <T extends EnchantmentEntityEffect> MapCodec<T> registerEnchantmentEntityEffect(ResourceLocation id, MapCodec<T> codec);

    /**
     * Registers an Enchantment Location Based Effect codec.
     *
     * @param id    The identifier for the effect.
     * @param codec The codec for the effect.
     * @param <T>   The type of the effect.
     * @return The registered codec.
     */
    <T extends EnchantmentLocationBasedEffect> MapCodec<T> registerEnchantmentLocationEffect(ResourceLocation id, MapCodec<T> codec);

    /**
     * Registers an Enchantment Value Effect codec.
     *
     * @param id    The identifier for the effect.
     * @param codec The codec for the effect.
     * @param <T>   The type of the effect.
     * @return The registered codec.
     */
    <T extends EnchantmentValueEffect> MapCodec<T> registerEnchantmentValueEffect(ResourceLocation id, MapCodec<T> codec);

    /**
     * Retrieves the registry entry for a registered block with a specific type.
     */
    <T extends Block> Holder<T> getBlock(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered item with a specific type.
     */
    <T extends Item> Holder<T> getItem(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered entity type with a specific type.
     */
    <T extends Entity> Holder<EntityType<T>> getEntity(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered mob effect with a specific type.
     */
    <T extends MobEffect> Holder<T> getEffect(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered creative mode tab.
     */
    <T extends CreativeModeTab> Holder<T> getCreativeTab(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered armor material with a specific type.
     */
    <T extends ArmorMaterial> Holder<T> getArmorMaterial(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered enchantment with a specific type.
     */
    <T extends Enchantment> Holder<T> getEnchantment(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered fluid with a specific type.
     */
    <T extends Fluid> Holder<T> getFluid(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered potion with a specific type.
     */
    <T extends Potion> Holder<T> getPotion(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered sound event with a specific type.
     */
    <T extends SoundEvent> Holder<T> getSound(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered block entity type with a specific type.
     */
    <T extends BlockEntityType<?>> Holder<T> getBlockEntity(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered data component type with a specific type.
     */
    <T> Holder<DataComponentType<T>> getDataComponent(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered attribute with a specific type.
     */
    <T extends Attribute> Holder<T> getAttribute(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered particle type with a specific type.
     */
    <T extends ParticleType<?>> Holder<T> getParticle(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered menu type with a specific type.
     */
    <T extends MenuType<?>> Holder<T> getMenu(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered recipe serializer with a specific type.
     */
    <T extends RecipeSerializer<?>> Holder<T> getRecipeSerializer(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered recipe type with a specific type.
     */
    <T extends RecipeType<?>> Holder<T> getRecipeType(ResourceLocation id);

    /**
     * Retrieves the registry entry for a registered villager profession with a specific type.
     */
    <T extends VillagerProfession> Holder<T> getVillagerProfession(ResourceLocation id);
}
