package ${MAIN_CLASS.packageName}.registry;

import ${MAIN_CLASS.packageName}.Constants;
import ${MAIN_CLASS.packageName}.platform.Services;
import net.minecraft.core.Holder;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.Identifier;
import net.minecraft.world.item.CreativeModeTab;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;

import java.util.function.Supplier;

public class ModCreativeTabs {

    // Example Tab
    // public static final Holder<CreativeModeTab> EXAMPLE_TAB = register("example_tab", () -> CreativeModeTab.builder()
    //         .title(Component.translatable("itemGroup." + Constants.MOD_ID + ".example_tab"))
    //         .icon(() -> new ItemStack(Items.DIAMOND))
    //         .displayItems((params, output) -> {
    //             output.accept(ModItems.EXAMPLE_ITEM.get());
    //         })
    //         .build());

    private static <T extends CreativeModeTab> Holder<T> register(String name, Supplier<T> tab) {
        Identifier id = Identifier.fromNamespaceAndPath(Constants.MOD_ID, name);
        Services.REGISTRY.registerCreativeTab(id, tab);
        return Services.REGISTRY.getCreativeTab(id);
    }

    public static void register() {
         Constants.LOG.debug("Registering Creative Tabs for " + Constants.MOD_NAME);
    }
}
