package ${MAIN_CLASS.packageName}.registry;

import ${MAIN_CLASS.packageName}.Constants;
import ${MAIN_CLASS.packageName}.platform.Services;
import net.minecraft.core.Holder;
import net.minecraft.resources.Identifier;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.state.BlockBehaviour;

import java.util.function.Supplier;

public class ModBlocks {

    // Example Block
    // public static final Holder<Block> EXAMPLE_BLOCK = register("example_block", () -> new Block(BlockBehaviour.Properties.of()));

    private static <T extends Block> Holder<T> register(String name, Supplier<T> block) {
        Identifier id = Identifier.fromNamespaceAndPath(Constants.MOD_ID, name);
        Services.REGISTRY.registerBlock(id, block);
        return Services.REGISTRY.getBlock(id);
    }

    public static void register() {
         Constants.LOG.debug("Registering Blocks for " + Constants.MOD_NAME);
    }
}
