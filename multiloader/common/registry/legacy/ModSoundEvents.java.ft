package ${MAIN_CLASS.packageName}.registry;

import ${MAIN_CLASS.packageName}.Constants;
import ${MAIN_CLASS.packageName}.platform.Services;
import net.minecraft.core.Holder;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.sounds.SoundEvent;

import java.util.function.Supplier;

public class ModSoundEvents {

    // Example Sound
    // public static final Holder<SoundEvent> EXAMPLE_SOUND = register("example_sound", () -> SoundEvent.createVariableRangeEvent(ResourceLocation.fromNamespaceAndPath(Constants.MOD_ID, "example_sound")));

    private static <T extends SoundEvent> Holder<T> register(String name, Supplier<T> sound) {
        ResourceLocation id = ResourceLocation.fromNamespaceAndPath(Constants.MOD_ID, name);
        Services.REGISTRY.registerSound(id, sound);
        return Services.REGISTRY.getSound(id);
    }

    public static void register() {
        Constants.LOG.debug("Registering Sound Events for " + Constants.MOD_NAME);
    }
}
