package ${MAIN_CLASS.packageName}.registry;

import ${MAIN_CLASS.packageName}.Constants;
import ${MAIN_CLASS.packageName}.platform.Services;
import net.minecraft.core.Holder;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.effect.MobEffect;
import net.minecraft.world.item.alchemy.Potion;

import java.util.function.Supplier;

public class ModEffects {

    // Example Effect
    // public static final Holder<MobEffect> EXAMPLE_EFFECT = registerEffect("example_effect", () -> new MobEffect(MobEffectCategory.BENEFICIAL, 0xFFFFFF));
    
    // Example Potion
    // public static final Holder<Potion> EXAMPLE_POTION = registerPotion("example_potion", () -> new Potion(new MobEffectInstance(EXAMPLE_EFFECT, 3600)));

    private static <T extends MobEffect> Holder<T> registerEffect(String name, Supplier<T> effect) {
        ResourceLocation id = ResourceLocation.fromNamespaceAndPath(Constants.MOD_ID, name);
        Services.REGISTRY.registerEffect(id, effect);
        return Services.REGISTRY.getEffect(id);
    }

    private static <T extends Potion> Holder<T> registerPotion(String name, Supplier<T> potion) {
        ResourceLocation id = ResourceLocation.fromNamespaceAndPath(Constants.MOD_ID, name);
        Services.REGISTRY.registerPotion(id, potion);
        return Services.REGISTRY.getPotion(id);
    }

    public static void register() {
        Constants.LOG.debug("Registering Effects for " + Constants.MOD_NAME);
    }
}
