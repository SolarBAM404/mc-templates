package ${MAIN_CLASS.packageName}.platform;

import com.mojang.serialization.MapCodec;
import ${MAIN_CLASS.packageName}.platform.services.IContentRegistry;
import net.minecraft.core.Holder;
import net.minecraft.core.Registry;
import net.minecraft.core.component.DataComponentType;
import net.minecraft.core.particles.ParticleType;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.resources.Identifier;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.world.effect.MobEffect;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.ai.attributes.Attribute;
import net.minecraft.world.entity.npc.VillagerProfession;
import net.minecraft.world.inventory.MenuType;
import net.minecraft.world.item.ArmorMaterial;
import net.minecraft.world.item.CreativeModeTab;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.alchemy.Potion;
import net.minecraft.world.item.crafting.RecipeSerializer;
import net.minecraft.world.item.crafting.RecipeType;
import net.minecraft.world.item.enchantment.Enchantment;
import net.minecraft.world.item.enchantment.effects.EnchantmentEntityEffect;
import net.minecraft.world.item.enchantment.effects.EnchantmentLocationBasedEffect;
import net.minecraft.world.item.enchantment.effects.ValueEffect;
import net.minecraft.world.level.GameRules;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.entity.BlockEntityType;
import net.minecraft.world.level.material.Fluid;

import java.util.HashMap;
import java.util.Map;
import java.util.function.Supplier;
import java.util.function.UnaryOperator;

/**
 * Fabric implementation of the {@link IContentRegistry} service.
 * Supports Minecraft 1.21.x (1.21.11 targeted) features.
 */
public class FabricContentRegistry implements IContentRegistry {

    private final Map<ResourceLocation, Holder<?>> holders = new HashMap<>();

    @Override
    public <T extends Block> void registerBlock(Identifier id, Supplier<T> block) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.BLOCK, id, block.get()));
    }

    @Override
    public <T extends Item> void registerItem(Identifier id, Supplier<T> item) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.ITEM, id, item.get()));
    }

    @Override
    public <T extends MobEffect> void registerEffect(Identifier id, Supplier<T> effect) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.MOB_EFFECT, id, effect.get()));
    }

    @Override
    public <T extends Entity> void registerEntity(Identifier id, Supplier<EntityType<T>> entity) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.ENTITY_TYPE, id, entity.get()));
    }

    @Override
    public <T extends CreativeModeTab> void registerCreativeTab(Identifier id, Supplier<T> tab) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.CREATIVE_MODE_TAB, id, tab.get()));
    }

    @Override
    public <T extends ArmorMaterial> void registerArmorMaterial(Identifier id, Supplier<T> armorMaterial) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.ARMOR_MATERIAL, id, armorMaterial.get()));
    }

    @Override
    public <T extends Fluid> void registerFluid(Identifier id, Supplier<T> fluid) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.FLUID, id, fluid.get()));
    }

    @Override
    public <T extends Potion> void registerPotion(Identifier id, Supplier<T> potion) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.POTION, id, potion.get()));
    }

    @Override
    public <T extends SoundEvent> void registerSound(Identifier id, Supplier<T> sound) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.SOUND_EVENT, id, sound.get()));
    }

    @Override
    public <T extends BlockEntityType<?>> void registerBlockEntity(Identifier id, Supplier<T> block) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.BLOCK_ENTITY_TYPE, id, block.get()));
    }

    @Override
    public <T> void registerDataComponent(Identifier id, UnaryOperator<DataComponentType.Builder<T>> builder) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.DATA_COMPONENT_TYPE, id, builder.apply(DataComponentType.builder()).build()));
    }

    @Override
    public <T extends Attribute> void registerAttribute(Identifier id, Supplier<T> attribute) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.ATTRIBUTE, id, attribute.get()));
    }

    @Override
    public <T extends ParticleType<?>> void registerParticle(Identifier id, Supplier<T> particle) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.PARTICLE_TYPE, id, particle.get()));
    }

    @Override
    public <T extends MenuType<?>> void registerMenu(Identifier id, Supplier<T> menu) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.MENU, id, menu.get()));
    }

    @Override
    public <T extends RecipeSerializer<?>> void registerRecipeSerializer(Identifier id, Supplier<T> serializer) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.RECIPE_SERIALIZER, id, serializer.get()));
    }

    @Override
    public <T extends RecipeType<?>> void registerRecipeType(Identifier id, Supplier<T> type) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.RECIPE_TYPE, id, type.get()));
    }

    @Override
    public <T extends VillagerProfession> void registerVillagerProfession(Identifier id, Supplier<T> profession) {
        holders.put(id, Registry.registerForHolder(BuiltInRegistries.VILLAGER_PROFESSION, id, profession.get()));
    }

    @Override
    public <T extends GameRules.Value<T>> GameRules.Key<T> registerGameRule(String name, GameRules.Category category, GameRules.Type<T> type) {
        return GameRules.register(name, category, type);
    }

    @Override
    public <T extends EnchantmentEntityEffect> MapCodec<T> registerEnchantmentEntityEffect(Identifier id, MapCodec<T> codec) {
        return Registry.register(BuiltInRegistries.ENCHANTMENT_ENTITY_EFFECT_TYPE, id, codec);
    }

    @Override
    public <T extends EnchantmentLocationBasedEffect> MapCodec<T> registerEnchantmentLocationEffect(Identifier id, MapCodec<T> codec) {
        return Registry.register(BuiltInRegistries.ENCHANTMENT_LOCATION_BASED_EFFECT_TYPE, id, codec);
    }

    @Override
    public <T extends ValueEffect> MapCodec<T> registerEnchantmentValueEffect(Identifier id, MapCodec<T> codec) {
        return Registry.register(BuiltInRegistries.ENCHANTMENT_VALUE_EFFECT_TYPE, id, codec);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Block> Holder<T> getBlock(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Item> Holder<T> getItem(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Entity> Holder<EntityType<T>> getEntity(Identifier id) {
        return (Holder<EntityType<T>>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends MobEffect> Holder<T> getEffect(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends CreativeModeTab> Holder<T> getCreativeTab(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Enchantment> Holder<T> getEnchantment(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends ArmorMaterial> Holder<T> getArmorMaterial(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Fluid> Holder<T> getFluid(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Potion> Holder<T> getPotion(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends SoundEvent> Holder<T> getSound(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends BlockEntityType<?>> Holder<T> getBlockEntity(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T> Holder<DataComponentType<T>> getDataComponent(Identifier id) {
        return (Holder<DataComponentType<T>>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Attribute> Holder<T> getAttribute(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends ParticleType<?>> Holder<T> getParticle(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends MenuType<?>> Holder<T> getMenu(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends RecipeSerializer<?>> Holder<T> getRecipeSerializer(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends RecipeType<?>> Holder<T> getRecipeType(Identifier id) {
        return (Holder<T>) holders.get(id);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends VillagerProfession> Holder<T> getVillagerProfession(Identifier id) {
        return (Holder<T>) holders.get(id);
    }
}
