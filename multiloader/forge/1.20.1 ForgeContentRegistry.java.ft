package ${MAIN_CLASS.packageName}.platform;

import ${MAIN_CLASS.packageName}.Constants;
import ${MAIN_CLASS.packageName}.platform.services.IContentRegistry;
import net.minecraft.core.Holder;
import net.minecraft.core.Registry;
import net.minecraft.core.registries.Registries;
import net.minecraft.resources.ResourceKey;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.world.effect.MobEffect;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.ai.attributes.Attribute;
import net.minecraft.world.entity.npc.VillagerProfession;
import net.minecraft.world.inventory.MenuType;
import net.minecraft.world.item.ArmorMaterial;
import net.minecraft.world.item.CreativeModeTab;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.alchemy.Potion;
import net.minecraft.world.item.crafting.RecipeSerializer;
import net.minecraft.world.item.crafting.RecipeType;
import net.minecraft.world.item.enchantment.Enchantment;
import net.minecraft.world.level.GameRules;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.entity.BlockEntityType;
import net.minecraft.world.level.material.Fluid;
import net.minecraftforge.fml.javafmlmod.FMLJavaModLoadingContext;
import net.minecraftforge.registries.DeferredRegister;
import net.minecraftforge.registries.ForgeRegistries;
import net.minecraftforge.registries.RegistryObject;

import java.util.HashMap;
import java.util.Map;
import java.util.function.Supplier;

/**
 * Forge implementation of the {@link IContentRegistry} service.
 * Targeted for Minecraft 1.20.1.
 */
public class ForgeContentRegistry implements IContentRegistry {

    private final Map<ResourceKey<? extends Registry<?>>, DeferredRegister<?>> registers = new HashMap<>();
    private final Map<ResourceLocation, RegistryObject<?>> objects = new HashMap<>();

    @SuppressWarnings("unchecked")
    private <T> DeferredRegister<T> getRegister(ResourceKey<Registry<T>> key) {
        return (DeferredRegister<T>) registers.computeIfAbsent(key, k -> {
            DeferredRegister<T> register = DeferredRegister.create(key, Constants.MOD_ID);
            register.register(FMLJavaModLoadingContext.get().getModEventBus());
            return register;
        });
    }

    @Override
    public <T extends Block> void registerBlock(ResourceLocation id, Supplier<T> block) {
        objects.put(id, getRegister(ForgeRegistries.Keys.BLOCKS).register(id.getPath(), block));
    }

    @Override
    public <T extends Item> void registerItem(ResourceLocation id, Supplier<T> item) {
        objects.put(id, getRegister(ForgeRegistries.Keys.ITEMS).register(id.getPath(), item));
    }

    @Override
    public <T extends MobEffect> void registerEffect(ResourceLocation id, Supplier<T> effect) {
        objects.put(id, getRegister(ForgeRegistries.Keys.MOB_EFFECTS).register(id.getPath(), effect));
    }

    @Override
    public <T extends Entity> void registerEntity(ResourceLocation id, Supplier<EntityType<T>> entity) {
        objects.put(id, getRegister(ForgeRegistries.Keys.ENTITY_TYPES).register(id.getPath(), entity));
    }

    @Override
    public <T extends CreativeModeTab> void registerCreativeTab(ResourceLocation id, Supplier<T> tab) {
        objects.put(id, getRegister(Registries.CREATIVE_MODE_TAB).register(id.getPath(), tab));
    }

    @Override
    public <T extends ArmorMaterial> void registerArmorMaterial(ResourceLocation id, Supplier<T> armorMaterial) {
        // ArmorMaterial might not be a registry in some Forge versions, but we'll try to use the key if available.
        // Actually, ArmorMaterial is often not a registry in 1.20.1 Forge. 
        // We'll leave it as a skip or use a custom handler if it's strictly needed.
    }

    @Override
    public <T extends Fluid> void registerFluid(ResourceLocation id, Supplier<T> fluid) {
        objects.put(id, getRegister(ForgeRegistries.Keys.FLUIDS).register(id.getPath(), fluid));
    }

    @Override
    public <T extends Potion> void registerPotion(ResourceLocation id, Supplier<T> potion) {
        objects.put(id, getRegister(ForgeRegistries.Keys.POTIONS).register(id.getPath(), potion));
    }

    @Override
    public <T extends SoundEvent> void registerSound(ResourceLocation id, Supplier<T> sound) {
        objects.put(id, getRegister(ForgeRegistries.Keys.SOUND_EVENTS).register(id.getPath(), sound));
    }

    @Override
    public <T extends BlockEntityType<?>> void registerBlockEntity(ResourceLocation id, Supplier<T> block) {
        objects.put(id, getRegister(ForgeRegistries.Keys.BLOCK_ENTITY_TYPES).register(id.getPath(), block));
    }

    @Override
    public <T extends Attribute> void registerAttribute(ResourceLocation id, Supplier<T> attribute) {
        objects.put(id, getRegister(ForgeRegistries.Keys.ATTRIBUTES).register(id.getPath(), attribute));
    }

    @Override
    public <T extends MenuType<?>> void registerMenu(ResourceLocation id, Supplier<T> menu) {
        objects.put(id, getRegister(ForgeRegistries.Keys.MENU_TYPES).register(id.getPath(), menu));
    }

    @Override
    public <T extends RecipeSerializer<?>> void registerRecipeSerializer(ResourceLocation id, Supplier<T> serializer) {
        objects.put(id, getRegister(ForgeRegistries.Keys.RECIPE_SERIALIZERS).register(id.getPath(), serializer));
    }

    @Override
    public <T extends RecipeType<?>> void registerRecipeType(ResourceLocation id, Supplier<T> type) {
        objects.put(id, getRegister(Registries.RECIPE_TYPE).register(id.getPath(), type));
    }

    @Override
    public <T extends VillagerProfession> void registerVillagerProfession(ResourceLocation id, Supplier<T> profession) {
        objects.put(id, getRegister(ForgeRegistries.Keys.VILLAGER_PROFESSIONS).register(id.getPath(), profession));
    }

    @Override
    public <T extends GameRules.Value<T>> GameRules.Key<T> registerGameRule(String name, GameRules.Category category, GameRules.Type<T> type) {
        return GameRules.register(name, category, type);
    }

    @Override
    public <T extends Enchantment> Holder<T> registerEnchantment(ResourceLocation id, Supplier<T> enchantment) {
        RegistryObject<T> ro = getRegister(ForgeRegistries.Keys.ENCHANTMENTS).register(id.getPath(), enchantment);
        objects.put(id, ro);
        return ro.getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Block> Holder<T> getBlock(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Item> Holder<T> getItem(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Entity> Holder<EntityType<T>> getEntity(ResourceLocation id) {
        return (Holder<EntityType<T>>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends MobEffect> Holder<T> getEffect(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends CreativeModeTab> Holder<T> getCreativeTab(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Enchantment> Holder<T> getEnchantment(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends ArmorMaterial> Holder<T> getArmorMaterial(ResourceLocation id) {
        return null; // Not typically a registry in 1.20.1 Forge
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Fluid> Holder<T> getFluid(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Potion> Holder<T> getPotion(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends SoundEvent> Holder<T> getSound(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends BlockEntityType<?>> Holder<T> getBlockEntity(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends Attribute> Holder<T> getAttribute(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends MenuType<?>> Holder<T> getMenu(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends RecipeSerializer<?>> Holder<T> getRecipeSerializer(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends RecipeType<?>> Holder<T> getRecipeType(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }

    @SuppressWarnings("unchecked")
    @Override
    public <T extends VillagerProfession> Holder<T> getVillagerProfession(ResourceLocation id) {
        return (Holder<T>) objects.get(id).getHolder().orElse(null);
    }
}
