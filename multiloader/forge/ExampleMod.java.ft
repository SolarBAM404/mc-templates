package ${MAIN_CLASS.packageName};

import net.minecraftforge.fml.common.Mod;
import net.minecraftforge.fml.javafmlmod.FMLJavaModLoadingContext;

@Mod(Constants.MOD_ID)
public class ${MAIN_CLASS.className} {

    private static FMLJavaModLoadingContext context;

    public ${MAIN_CLASS.className}(FMLJavaModLoadingContext context) {
        // This method is invoked by the Forge mod loader when it is ready
        // to load your mod. You can access Forge and Common code in this
        // project.
        ${MAIN_CLASS.className}.context = context;

        // Use Forge to bootstrap the Common mod.
        Constants.LOG.info("Hello Forge world!");
        CommonClass.init();

    }

    public static FMLJavaModLoadingContext getContext() {
        return context;
    }
}
